	local function setFlyState(enable: boolean)
		if isFlying == enable then return end
		isFlying = enable
		
		local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		
		if isFlying then
			TweenService:Create(toggleFrame, tInfo, {
				BackgroundColor3 = COLOR_TOGGLE_ON
			}):Play()
	
			TweenService:Create(toggleKnob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(1, -22, 0, 0),
				Size = UDim2.new(0, 22, 0, 20)
			}):Play()
			task.delay(0.12, function()
				if isFlying then
					TweenService:Create(toggleKnob, TweenInfo.new(0.13, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Position = UDim2.new(1, -20, 0, 0),
						Size = UDim2.new(0, 20, 0, 20)
					}):Play()
				end
			end)
			
			startFlight()
		else
			TweenService:Create(toggleFrame, tInfo, {
				BackgroundColor3 = COLOR_TOGGLE_OFF
			}):Play()
			
			TweenService:Create(toggleKnob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 0, 0, 0),
				Size = UDim2.new(0, 22, 0, 20)
			}):Play()
			task.delay(0.12, function()
				if not isFlying then
					TweenService:Create(toggleKnob, TweenInfo.new(0.13, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Position = UDim2.new(0, 0, 0, 0),
						Size = UDim2.new(0, 20, 0, 20)
					}):Play()
				end
			end)
			
			stopFlight()
		end
	end
	
	toggleFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			setFlyState(not isFlying)
		end
	end)
	
	local function setupButton(btn: GuiObject, onHoldStart: () -> (), onHoldEnd: () -> ())
		local scale = btn:FindFirstChildOfClass("UIScale")
		if not scale then
			scale = Instance.new("UIScale")
			scale.Parent = btn
		end
		
		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = COLOR_BG_HOVER
			}):Play()
		end)
		
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = COLOR_BG_NORMAL
			}):Play()
			onHoldEnd()
		end)
		
		btn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				TweenService:Create(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Scale = 0.93
				}):Play()
				TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundColor3 = COLOR_BG_PRESS
				}):Play()
				
				if not isFlying then
					setFlyState(true)
				end
				onHoldStart()
			end
		end)
		
		btn.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Scale = 1.0
				}):Play()
				TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundColor3 = isMouseOver(btn, input.Position) and COLOR_BG_HOVER or COLOR_BG_NORMAL
				}):Play()
				onHoldEnd()
			end
		end)
	end
	
	setupButton(upBtn, function()
		isUpPressed = true
	end, function()
		isUpPressed = false
	end)
	
	setupButton(downBtn, function()
		isDownPressed = true
	end, function()
		isDownPressed = false
	end)
	
	main.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local pos = input.Position
			-- Ignore clicks inside interactive children
			if isMouseOver(sliderFrame, pos) or isMouseOver(toggleFrame, pos) or
			   isMouseOver(upBtn, pos) or isMouseOver(downBtn, pos) or
			   isMouseOver(speedInput, pos) or isMouseOver(closeBtn, pos) then
				return
			end
			
			isDraggingWindow = true
			dragStart = input.Position
			frameStartPos = main.Position
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			if isDraggingWindow then
				local delta = input.Position - dragStart
				local target = UDim2.new(
					frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
					frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
				)
				TweenService:Create(main, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = target
				}):Play()
			elseif isDraggingSlider then
				handleSliderInput(input.Position.X)
			end
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isDraggingWindow then
				isDraggingWindow = false
				local clamped = clampWindowToScreen(main.Position)
				TweenService:Create(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = clamped
				}):Play()
			end
			if isDraggingSlider then
				isDraggingSlider = false
				updateSliderVisual(currentSpeed, true)
			end
		end
	end)
	
	local function cleanupMovers()
		if bodyVelocity and bodyVelocity.Parent then
			bodyVelocity:Destroy()
		end
		bodyVelocity = nil
		if bodyGyro and bodyGyro.Parent then
			bodyGyro:Destroy()
		end
		bodyGyro = nil
	end
	
	function startFlight()
		character = player.Character
		if not character then return end
		humanoid = character:FindFirstChildOfClass("Humanoid")
		hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not humanoid or not hrp then return end
		
		cleanupMovers()
		
		humanoid.PlatformStand = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		
		local bv = Instance.new("BodyVelocity")
		bv.Name = "FlyVelocity"
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		bodyVelocity = bv
		
		local bg = Instance.new("BodyGyro")
		bg.Name = "FlyGyro"
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 15000
		bg.D = 600
		bg.CFrame = hrp.CFrame
		bg.Parent = hrp
		bodyGyro = bg
		
		currentVelocity = Vector3.zero
	end
	
	function stopFlight()
		cleanupMovers()
		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
		currentVelocity = Vector3.zero
	end
	
	RunService.RenderStepped:Connect(function(dt)
		if not isFlying then return end
		if not character or not humanoid or not hrp or not hrp.Parent then
			return
		end
		
		local fwd = 0
		local side = 0
		local vert = 0
		
		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
				fwd = fwd + 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
				fwd = fwd - 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
				side = side + 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
				side = side - 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
				vert = vert + 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
				vert = vert - 1
			end
		end
		
		if isUpPressed then vert = vert + 1 end
		if isDownPressed then vert = vert - 1 end
		
		local camCF = camera.CFrame
		local rawLook = camCF.LookVector
		local rawRight = camCF.RightVector
		
		local flatLook = Vector3.new(rawLook.X, 0, rawLook.Z)
		if flatLook.Magnitude > 0.001 then
			flatLook = flatLook.Unit
		else
			flatLook = hrp.CFrame.LookVector
		end
		
		local flatRight = Vector3.new(rawRight.X, 0, rawRight.Z)
		if flatRight.Magnitude > 0.001 then
			flatRight = flatRight.Unit
		else
			flatRight = hrp.CFrame.RightVector
		end
		
		local moveDir = Vector3.zero
		if fwd ~= 0 then
			moveDir = moveDir + (flatLook * fwd)
		end
		if side ~= 0 then
			moveDir = moveDir + (flatRight * side)
		end
		if vert ~= 0 then
			moveDir = moveDir + (Vector3.new(0, 1, 0) * vert)
		end
		
		if fwd == 0 and side == 0 and UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			if humanoid.MoveDirection.Magnitude > 0.1 then
				moveDir = moveDir + humanoid.MoveDirection
			end
		end
		
		local maxSpeedStuds = currentSpeed * baseStudsPerSec
		local targetVel = Vector3.zero
		if moveDir.Magnitude > 0.01 then
			targetVel = moveDir.Unit * maxSpeedStuds
		end
		
		local accel = (targetVel.Magnitude > 0) and 14 or 10
		currentVelocity = currentVelocity:Lerp(targetVel, math.clamp(dt * accel, 0, 1))
		if currentVelocity.Magnitude < 0.05 and targetVel.Magnitude == 0 then
			currentVelocity = Vector3.zero
		end
		
		if bodyVelocity and bodyVelocity.Parent then
			bodyVelocity.Velocity = currentVelocity
		end
		
		if bodyGyro and bodyGyro.Parent then
			local baseCF = CFrame.lookAt(hrp.Position, hrp.Position + flatLook)
			
			local forwardRatio = math.clamp(currentVelocity:Dot(flatLook) / math.max(maxSpeedStuds, 1), -1, 1)
			local pitch = -math.rad(22) * forwardRatio
			
			local strafeRatio = math.clamp(currentVelocity:Dot(flatRight) / math.max(maxSpeedStuds, 1), -1, 1)
			local roll = -math.rad(16) * strafeRatio
			
			local targetCF = baseCF * CFrame.Angles(pitch, 0, roll)
			bodyGyro.CFrame = bodyGyro.CFrame:Lerp(targetCF, math.clamp(dt * 15, 0, 1))
		end
	end)
	
	local function onCharacterAdded(newChar: Model)
		character = newChar
		humanoid = newChar:WaitForChild("Humanoid") :: Humanoid
		hrp = newChar:WaitForChild("HumanoidRootPart") :: BasePart
		
		if isFlying then
			startFlight()
		end
		
		humanoid.Died:Connect(function()
			cleanupMovers()
			if isFlying then
				setFlyState(false)
			end
		end)
	end
	
	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
	
	updateSliderVisual(currentSpeed, false)
	toggleFrame.BackgroundColor3 = COLOR_TOGGLE_OFF
	toggleKnob.Position = UDim2.new(0, 0, 0, 0)
end;
