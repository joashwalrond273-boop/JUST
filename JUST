local function C_4()
local script = G2L["4"];
	--!strict
	--zerohub.cc
	--dnezero was here
	
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local RunService = game:GetService("RunService")
	local GuiService = game:GetService("GuiService")
	
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local screenGui = script.Parent :: ScreenGui
	local main = screenGui:WaitForChild("main") :: Frame
	local sliderFrame = main:WaitForChild("flyspeedslider") :: Frame
	local sliderKnob = sliderFrame:WaitForChild("slider") :: Frame
	local fillBar = sliderFrame:WaitForChild("fill") :: Frame
	local toggleFrame = main:WaitForChild("toggleflytoggle") :: Frame
	local toggleKnob = (toggleFrame:FindFirstChild("knob") or toggleFrame:FindFirstChild("Frame")) :: Frame
	local upBtn = main:WaitForChild("up") :: Frame
	local downBtn = main:WaitForChild("down") :: Frame
	local speedInput = main:WaitForChild("flyspeedcount") :: GuiObject
	local closeBtn = main:WaitForChild("closebtn") :: Frame
	
	-- URIEL theme applies a UIScale to make the whole menu smaller. Absolute
	-- sizes are reported in screen space, but child offsets are written in the
	-- frame's local (unscaled) space, so the slider math has to divide by it.
	local uiScaleObj = main:FindFirstChildOfClass("UIScale")
	local function getGuiScale(): number
		if uiScaleObj and uiScaleObj.Scale > 0 then
			return uiScaleObj.Scale
		end
		return 1
	end
	
	local COLOR_BG_NORMAL = Color3.fromRGB(26, 34, 34)
	local COLOR_BG_HOVER = Color3.fromRGB(40, 52, 52)
	local COLOR_BG_PRESS = Color3.fromRGB(56, 72, 72)
	local COLOR_TOGGLE_ON = Color3.fromRGB(0, 244, 255) 
	local COLOR_TOGGLE_OFF = Color3.fromRGB(26, 34, 34)
	
	local isFlying = false
	local currentSpeed = 1
	local minSpeed = 1
	local maxSpeed = 10
	local baseStudsPerSec = 45
	
	local isDraggingWindow = false
	local isDraggingSlider = false
	local isUpPressed = false
	local isDownPressed = false
	
	local dragStart = Vector3.zero
	local frameStartPos = UDim2.new()
	
	local character: Model? = nil
	local humanoid: Humanoid? = nil
	local hrp: BasePart? = nil
	local bodyVelocity: BodyVelocity? = nil
	local bodyGyro: BodyGyro? = nil
	local currentVelocity = Vector3.zero
	
	local startFlight: () -> ()
	local stopFlight: () -> ()
	
	local function isMouseOver(guiObject: GuiObject, mousePos: Vector2 | Vector3): boolean
		local pos = guiObject.AbsolutePosition
		local size = guiObject.AbsoluteSize
		return mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
		       mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y
	end
	
	local function clampWindowToScreen(pos: UDim2): UDim2
		local vp = camera.ViewportSize
		local frameSize = main.AbsoluteSize
		local minX = frameSize.X * 0.5
		local maxX = math.max(minX, vp.X - (frameSize.X * 0.5))
		local minY = frameSize.Y * 0.5 + GuiService:GetGuiInset().Y
		local maxY = math.max(minY, vp.Y - (frameSize.Y * 0.5))
		
		local absX = (pos.X.Scale * vp.X) + pos.X.Offset
		local absY = (pos.Y.Scale * vp.Y) + pos.Y.Offset
		
		local clampedX = math.clamp(absX, minX, maxX)
		local clampedY = math.clamp(absY, minY, maxY)
		
		return UDim2.new(0, clampedX, 0, clampedY)
	end
	
	local function updateSliderVisual(speedVal: number, animate: boolean)
		local s = getGuiScale()
		local trackWidth = sliderFrame.AbsoluteSize.X / s
		local knobWidth = sliderKnob.AbsoluteSize.X / s
		local knobHeight = sliderKnob.AbsoluteSize.Y / s
		if trackWidth <= 0 then trackWidth = 278 end
		if knobWidth <= 0 then knobWidth = 30 end
		if knobHeight <= 0 then knobHeight = 15 end
		local travel = trackWidth - knobWidth
		
		local alpha = math.clamp((speedVal - minSpeed) / (maxSpeed - minSpeed), 0, 1)
		local targetX = alpha * travel
		local targetFillWidth = math.clamp(targetX + knobWidth, 10, trackWidth)
		
		local displaySpeed = math.round(speedVal * 10) / 10
		if displaySpeed == math.round(displaySpeed) then
			if speedInput:IsA("TextBox") or speedInput:IsA("TextLabel") then
				(speedInput :: any).Text = tostring(math.round(displaySpeed))
			end
		else
			if speedInput:IsA("TextBox") or speedInput:IsA("TextLabel") then
				(speedInput :: any).Text = string.format("%.1f", displaySpeed)
			end
		end
		
		if animate then
			local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			TweenService:Create(sliderKnob, tInfo, {
				Position = UDim2.new(0, targetX, 0.5, -knobHeight * 0.5)
			}):Play()
			TweenService:Create(fillBar, tInfo, {
				Size = UDim2.new(0, targetFillWidth, 1, 0)
			}):Play()
		else
			sliderKnob.Position = UDim2.new(0, targetX, 0.5, -knobHeight * 0.5)
			fillBar.Size = UDim2.new(0, targetFillWidth, 1, 0)
		end
	end
	
	local function handleSliderInput(mouseX: number)
		local s = getGuiScale()
		local trackPos = sliderFrame.AbsolutePosition.X
		local trackWidth = sliderFrame.AbsoluteSize.X
		local knobWidth = sliderKnob.AbsoluteSize.X
		local knobHeight = sliderKnob.AbsoluteSize.Y
		local travel = trackWidth - knobWidth
		if travel <= 0 then return end
		
		local relX = mouseX - trackPos - (knobWidth * 0.5)
		local alpha = math.clamp(relX / travel, 0, 1)
		local rawVal = minSpeed + alpha * (maxSpeed - minSpeed)
		currentSpeed = math.round(rawVal)
		
		-- Convert screen-space travel back to the frame's local space.
		local localTravel = travel / s
		local localKnobWidth = knobWidth / s
		local targetX = alpha * localTravel
		sliderKnob.Position = UDim2.new(0, targetX, 0.5, -(knobHeight / s) * 0.5)
		fillBar.Size = UDim2.new(0, math.clamp(targetX + localKnobWidth, 10, trackWidth / s), 1, 0)
		if speedInput:IsA("TextBox") or speedInput:IsA("TextLabel") then
			(speedInput :: any).Text = tostring(currentSpeed)
		end
	end
	
	sliderFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDraggingSlider = true
			handleSliderInput(input.Position.X)
		end
	end)
	
	sliderKnob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDraggingSlider = true
			handleSliderInput(input.Position.X)
		end
	end)
	
	sliderKnob.MouseEnter:Connect(function()
		if not isDraggingSlider then
			TweenService:Create(sliderKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			}):Play()
		end
	end)
	
	sliderKnob.MouseLeave:Connect(function()
		if not isDraggingSlider then
			TweenService:Create(sliderKnob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = Color3.fromRGB(240, 240, 240)
			}):Play()
		end
	end)
	
	if speedInput:IsA("TextBox") then
		speedInput.FocusLost:Connect(function()
			local num = tonumber(speedInput.Text)
			if num and num > 0 then
				currentSpeed = math.clamp(num, 1, 100)
				updateSliderVisual(math.clamp(currentSpeed, minSpeed, maxSpeed), true)
				speedInput.Text = tostring(currentSpeed)
			else
				updateSliderVisual(currentSpeed, true)
			end
		end)
